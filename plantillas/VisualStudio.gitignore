# .gitignore para proyectos de Visual Studio y .NET Framework
# Versión reducida de la plantilla oficial de GitHub:
# https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Carpeta de configuración local de Visual Studio
.vs/

# Archivos de usuario (preferencias de cada quien)
*.user
*.suo
*.userosscache
*.sln.docstates

# Resultados de compilación
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/

# Paquetes NuGet (se restauran solos al compilar)
packages/
*.nupkg
!**/packages/build/

# Publicación
[Pp]ublish/
PublishProfiles/*.pubxml.user
*.publishproj

# Archivos temporales y de caché
*.cache
*.tmp
*.log
*.vspscc
*.vssscc
_ReSharper*/

# Archivos generados por Windows
Thumbs.db
Desktop.ini
